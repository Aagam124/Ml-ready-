MLREADY_ENV=development                 # production refuses to start with the default JWT secret
MLREADY_MONGO_URI=mongodb://localhost:27017
MLREADY_DB_NAME=mlready
MLREADY_JWT_SECRET=change-me-before-production
MLREADY_MAX_UPLOAD_MB=200
MLREADY_ACCESS_TTL_MINUTES=15
MLREADY_REFRESH_TTL_DAYS=7
MLREADY_GUEST_TTL_HOURS=24              # demo sessions and their data are deleted after this
MLREADY_AUTH_RATE_LIMIT_PER_MIN=10
MLREADY_UPLOAD_RATE_LIMIT_PER_MIN=20
MLREADY_ANALYSIS_SAMPLE_THRESHOLD=200000   # analyse a stratified sample above this many rows (and say so)
